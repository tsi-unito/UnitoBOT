{
  "name": "unitobot",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --no-warnings=ExperimentalWarning --loader ts-node/esm src/bot.ts",
    "test": "vitest",
    "test:ci": "vitest --run",
    "dev-server": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"npm run start\"",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "ci": "npm run type-check && npm run lint && npm run format:check && npm run build && npm run test:ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@mikro-orm/cli": "^6.5.2",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@grammyjs/chat-members": "^1.2.0",
    "@mikro-orm/core": "^6.5.2",
    "@mikro-orm/postgresql": "^6.5.2",
    "@mikro-orm/reflection": "^6.5.2",
    "@mikro-orm/sqlite": "^6.5.2",
    "dotenv": "^17.2.2",
    "grammy": "^1.38.2",
    "telegraf-middleware-console-time": "^3.0.0"
  }
}
